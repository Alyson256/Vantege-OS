<UserControl x:Class="Bitshift.Views.SystemSpecsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:Bitshift.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=viewmodels:SystemSpecsViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text2XL}" Text="{Binding TitleLabel}" />
                <Border Margin="10,0,0,0" Width="18" Height="18" CornerRadius="9" Background="#27272a" BorderBrush="{DynamicResource Zinc700Brush}" BorderThickness="1" Cursor="Help" VerticalAlignment="Center">
                    <Border.ToolTip>
                        <ToolTip Background="#18181b" BorderBrush="{DynamicResource Blue500Brush}" BorderThickness="1" Foreground="White" Padding="12,8" MaxWidth="340">
                            <StackPanel>
                                <TextBlock Text="WMI (Windows Management Instrumentation)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Blue500Brush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Interface segura oficial do Windows usada para identificar o modelo do seu processador, placa de vídeo e placa-mãe. O BITSHIFT consulta essas informações apenas 1 vez ao abrir o app, garantindo consumo zero de CPU e sem riscos de anti-cheat." FontSize="11" Foreground="{DynamicResource Zinc200Brush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </Border.ToolTip>
                    <TextBlock Text="i" Foreground="{DynamicResource Zinc300Brush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource TextSm}" Text="{Binding DescriptionLabel}" Foreground="{DynamicResource Zinc400Brush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Loading indicator -->
        <TextBlock Grid.Row="1" Text="Carregando hardware..." 
                   Foreground="{DynamicResource Zinc500Brush}" 
                   Style="{StaticResource TextSm}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <!-- Specs Grid (3 columns) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16" Padding="20">
                            <StackPanel>
                                <!-- Category Header -->
                                <TextBlock Text="{Binding Name}" 
                                           Style="{StaticResource TextLg}" 
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,16"/>

                                <!-- Spec Items -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Label}" 
                                                           Style="{StaticResource TextXs}" 
                                                           Foreground="{DynamicResource Zinc500Brush}" 
                                                           FontWeight="Medium"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding Value}" 
                                                           Style="{StaticResource TextSm}" 
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
