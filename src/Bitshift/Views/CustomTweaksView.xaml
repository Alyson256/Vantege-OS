<UserControl x:Class="Bitshift.Views.CustomTweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="CategoryFilterBtn" TargetType="Button">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="{DynamicResource Zinc400Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Zinc800Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Filters & Actions -->
            <RowDefinition Height="*"/>    <!-- Tweaks List -->
            <RowDefinition Height="180"/>  <!-- Console Drawer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text2XL}"/>
            <TextBlock Text="{Binding PageDesc}" Style="{StaticResource TextSm}" Foreground="{DynamicResource Zinc400Brush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Category Buttons & Actions Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Todos" Command="{Binding SetCategoryCommand}" CommandParameter="all" Style="{StaticResource CategoryFilterBtn}"/>
                <Button Content="Desempenho" Command="{Binding SetCategoryCommand}" CommandParameter="performance" Style="{StaticResource CategoryFilterBtn}"/>
                <Button Content="Privacidade" Command="{Binding SetCategoryCommand}" CommandParameter="privacy" Style="{StaticResource CategoryFilterBtn}"/>
                <Button Content="Rede" Command="{Binding SetCategoryCommand}" CommandParameter="network" Style="{StaticResource CategoryFilterBtn}"/>
                <Button Content="Sistema" Command="{Binding SetCategoryCommand}" CommandParameter="system" Style="{StaticResource CategoryFilterBtn}"/>
                <Button Content="Interface" Command="{Binding SetCategoryCommand}" CommandParameter="interface" Style="{StaticResource CategoryFilterBtn}"/>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{Binding SelectAllLabel}" Command="{Binding SelectAllCommand}" Style="{StaticResource CategoryFilterBtn}"/>
                <Button Content="{Binding ClearAllLabel}" Command="{Binding ClearAllCommand}" Style="{StaticResource CategoryFilterBtn}"/>
                <Button Content="Reverter" Command="{Binding UndoAllCommand}" Style="{StaticResource CategoryFilterBtn}"/>
                <Button Content="{Binding ApplySelectedLabel}" Command="{Binding ApplySelectedCommand}"
                        Background="{DynamicResource Blue500Brush}" Foreground="White" BorderThickness="0"
                        Padding="18,6" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tweaks List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding FilteredTweaks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#141419" BorderBrush="{DynamicResource Zinc800Brush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                    <ColumnDefinition Width="*"/>    <!-- Text info -->
                                    <ColumnDefinition Width="Auto"/> <!-- Script Badge & Status -->
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0" Cursor="Hand"/>

                                <!-- Text info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LocalizedName}" FontWeight="SemiBold" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="{Binding LocalizedDesc}" Foreground="{DynamicResource Zinc400Brush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Script Badge -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#181822" BorderBrush="{DynamicResource Zinc700Brush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ScriptFile}" Foreground="{DynamicResource Zinc400Brush}" FontSize="11" FontFamily="Consolas"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource Emerald500Brush}" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBlock Text="Aplicado" Foreground="{DynamicResource Emerald500Brush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Executando..." Foreground="{DynamicResource Amber500Brush}" FontSize="12"
                                               Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Console Drawer for Real-time Batch Output -->
        <Border Grid.Row="3" Background="#0C0C0F" BorderBrush="{DynamicResource Zinc800Brush}" BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Console de Execução (.BAT)" Foreground="{DynamicResource Zinc300Brush}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text=" • " Foreground="{DynamicResource Zinc600Brush}"/>
                        <TextBlock Text="{Binding ExecutionStatus}" Foreground="{DynamicResource Zinc400Brush}" FontSize="11"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Limpar Logs" Command="{Binding ClearLogsCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Zinc500Brush}" Cursor="Hand" FontSize="11"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ConsoleLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding IconGlyph}"
                                               Style="{StaticResource FluentIconSm}"
                                               Foreground="{Binding AccentBrush}"
                                               Margin="0,1,8,0"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Timestamp, StringFormat='[{0}]'}"
                                               Foreground="#71717A"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               Foreground="{Binding TextBrush}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
