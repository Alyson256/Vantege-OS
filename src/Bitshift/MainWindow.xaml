<ui:FluentWindow x:Class="Bitshift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Bitshift"
        xmlns:localViews="clr-namespace:Bitshift.Views"
        xmlns:viewmodels="clr-namespace:Bitshift.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="850" Width="1280"
        Icon="pack://application:,,,/Assets/bitshift.ico"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{StaticResource PlusJakartaSans}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <localViews:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PcBoostViewModel}">
            <localViews:PcBoostView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SystemSpecsViewModel}">
            <localViews:SystemSpecsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CustomTweaksViewModel}">
            <localViews:CustomTweaksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <localViews:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AboutViewModel}">
            <localViews:AboutView />
        </DataTemplate>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Zinc400Brush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#181822"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /> <!-- Sidebar (Dynamic Width) -->
            <ColumnDefinition Width="*" />    <!-- Content Area -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar (Expansível ou Mínima com Ícones) -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Background="#0c0c12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="250" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter Property="Width" Value="68" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Margin="12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header & Toggle -->
                    <RowDefinition Height="*" />    <!-- Navigation Links -->
                    <RowDefinition Height="Auto" /> <!-- Footer / Settings -->
                </Grid.RowDefinitions>

                <!-- Header / Logo do Aplicativo no Topo da Barra Lateral (Campo Mais Superior) -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <!-- Expanded Header: Logo Badge + Title + Collapse Button -->
                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Logo Badge -->
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentBrush}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextLg}" Text="BITSHIFT" Foreground="White" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Style="{StaticResource TextXs}" Text="{Binding BrandTaglineLabel}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ToggleSidebarCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Zinc500Brush}"
                                Cursor="Hand" ToolTip="Recolher menu lateral" Padding="4" VerticalAlignment="Center">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource FluentIcon}" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- Collapsed Header: Centered Logo Badge + Expand Button -->
                    <StackPanel Grid.Row="0" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Center" Margin="0,0,0,4">
                        <!-- Top Logo Badge (Clickable) -->
                        <Button Command="{Binding ToggleSidebarCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                ToolTip="BITSHIFT - seu sistema suas regras (Clique para expandir)">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentBrush}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Button>
                        <!-- Expand Toggle Button -->
                        <Button Command="{Binding ToggleSidebarCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Zinc400Brush}"
                                Cursor="Hand" ToolTip="Expandir menu lateral" HorizontalAlignment="Center" Padding="4">
                            <TextBlock Text="&#xE700;" Style="{StaticResource FluentIcon}" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Navigation Links -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Navigation Links -->
                    <StackPanel Grid.Row="0">
                        <!-- Dashboard -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="dashboard"
                                Style="{StaticResource SidebarButton}" ToolTip="{Binding DashboardLabel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE80F;" Style="{StaticResource FluentIcon}" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding DashboardLabel}" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Button>

                        <!-- PC Boost -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="pcboost"
                                Style="{StaticResource SidebarButton}" ToolTip="{Binding PcBoostLabel}" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7E6;" Style="{StaticResource FluentIcon}" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding PcBoostLabel}" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Button>

                        <!-- Especificações -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="specs"
                                Style="{StaticResource SidebarButton}" ToolTip="{Binding SpecsLabel}" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F8;" Style="{StaticResource FluentIcon}" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SpecsLabel}" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Button>

                        <!-- Customização (.BAT) -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="tweaks"
                                Style="{StaticResource SidebarButton}" ToolTip="{Binding TweaksLabel}" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE756;" Style="{StaticResource FluentIcon}" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding TweaksLabel}" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Button>

                        <!-- Configurações -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="settings"
                                Style="{StaticResource SidebarButton}" ToolTip="{Binding SettingsLabel}" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" Style="{StaticResource FluentIcon}" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SettingsLabel}" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Navigation Group: Verificar atualizações + Sobre -->
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="4,0,4,8"/>

                        <!-- Verificar atualizações (Versão + Estado do Software) -->
                        <Button Command="{Binding CheckUpdatesCommand}"
                                Style="{StaticResource SidebarButton}" ToolTip="{Binding UpdateMetaLabel}" Margin="0,0,0,0">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE895;" Style="{StaticResource FluentIcon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding UpdatesLabel}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding UpdateMetaLabel}" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource Zinc500Brush}"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Background="#181824"
                                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding UpdateStatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Zinc300Brush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Baixar nova versão no GitHub (quando disponível) -->
                        <Button Command="{Binding OpenLatestReleaseCommand}"
                                Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                                Padding="8,6" Margin="0,4,0,0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"
                                Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{Binding OpenReleaseLabel}" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- Ko-fi (abaixo de Verificar atualizações) -->
                        <Button Command="{Binding OpenKofiCommand}"
                                Style="{StaticResource SidebarButton}" ToolTip="Ko-fi" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xEB51;" Style="{StaticResource FluentIcon}" FontSize="15" Foreground="#FF5E5B" Margin="0,0,10,0"/>
                                <TextBlock Text="Ko-fi" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Button>

                        <!-- Sobre (abaixo do Ko-fi) -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="about"
                                Style="{StaticResource SidebarButton}" ToolTip="{Binding AboutLabel}" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE946;" Style="{StaticResource FluentIcon}" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding AboutLabel}" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Footer / Campo Perfil (Status, Cor e Privilégio ADM) -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <!-- Perfil Card (Expanded) -->
                    <Border Background="#12121a" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,8"
                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <StackPanel>
                            <!-- Header: Perfil & Status -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE77B;" Style="{StaticResource FluentIcon}" FontSize="13" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding SidebarProfileLabel}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1c1c28" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding AppStatusText}" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <!-- Cor do Sistema -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SidebarColorLabel}" Foreground="{DynamicResource Zinc400Brush}" FontSize="10" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding ReloadSystemAccentColorCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="Recarregar cor de destaque do Windows">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding AccentColorHex}" Foreground="{DynamicResource Zinc300Brush}" FontSize="9" FontFamily="Consolas"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Toggle Modo Seguro / ADM -->
                            <Button Command="{Binding ToggleAdministratorModeCommand}" Background="#181824" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Padding="6,4" Cursor="Hand" ToolTip="Alternar entre Modo Seguro e Modo Administrador (UAC)">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SidebarAdminBtnLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="&#xE7EF;" Style="{StaticResource FluentIcon}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Collapsed Perfil Quick Toggle & Color -->
                    <StackPanel Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Button Command="{Binding ToggleAdministratorModeCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,6" Cursor="Hand" ToolTip="{Binding AppStatusText}">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#14141d" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                                <TextBlock Text="&#xE7EF;" Style="{StaticResource FluentIcon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                        <Button Command="{Binding ReloadSystemAccentColorCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="{Binding AccentColorHex}">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Version, Theme & Language (Expanded) -->
                    <StackPanel Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="PT" Command="{Binding ChangeLanguageCommand}" CommandParameter="pt" Margin="0,0,6,0" Padding="8,2" BorderBrush="{DynamicResource Zinc700Brush}" BorderThickness="1" Cursor="Hand" FontSize="10">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource Zinc800Brush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Zinc300Brush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPortuguese}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="EN" Command="{Binding ChangeLanguageCommand}" CommandParameter="en" Margin="0,0,6,0" Padding="8,2" BorderBrush="{DynamicResource Zinc700Brush}" BorderThickness="1" Cursor="Hand" FontSize="10">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource Zinc800Brush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Zinc300Brush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeStatusLabel}" Padding="6,2" Background="{DynamicResource Zinc800Brush}" Foreground="{DynamicResource Zinc300Brush}" BorderBrush="{DynamicResource Zinc700Brush}" BorderThickness="1" Cursor="Hand">
                                <TextBlock FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
                                            <Setter Property="Text" Value="&#xE706;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkMode}" Value="False">
                                                    <Setter Property="Text" Value="&#xE708;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <TextBlock Text="{Binding CurrentVersion}" Foreground="{DynamicResource Zinc500Brush}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Version (Collapsed) -->
                    <TextBlock Text="{Binding CurrentVersion}" Foreground="{DynamicResource Zinc600Brush}" FontSize="9" FontFamily="Consolas" HorizontalAlignment="Center"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area (Routed via MVVM) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:TitleBar x:Name="RootTitleBar" Grid.Row="0" Height="34" ShowMinimize="True" ShowMaximize="True" />
            <ContentControl Grid.Row="1" Margin="28,8,28,28" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
