<Application x:Class="VantageOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VantageOS.Converters"
             xmlns:local="clr-namespace:VantageOS">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:PercentToColorConverter x:Key="PercentToColor" />
            <converters:NullToPlaceholderConverter x:Key="NullToPlaceholder" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
