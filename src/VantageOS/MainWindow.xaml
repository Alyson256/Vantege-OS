<Window x:Class="VantageOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VantageOS"
        xmlns:localViews="clr-namespace:VantageOS.Views"
        xmlns:viewmodels="clr-namespace:VantageOS.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{StaticResource PlusJakartaSans}">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <localViews:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SystemSpecsViewModel}">
            <localViews:SystemSpecsView />
        </DataTemplate>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Zinc400Brush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1a1a24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarButtonActive" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#1e1e2e" />
            <Setter Property="Foreground" Value="{DynamicResource Blue500Brush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" /> <!-- Sidebar -->
            <ColumnDefinition Width="*" /> <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Background="#111116">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Logo -->
                    <RowDefinition Height="*" />    <!-- Nav -->
                    <RowDefinition Height="Auto" /> <!-- Settings -->
                </Grid.RowDefinitions>
                
                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="0,0,0,30">
                    <TextBlock Style="{StaticResource Text2XL}" Text="Vantage OS" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Style="{StaticResource TextXs}" Text="CORE ENGINE" Foreground="{DynamicResource Zinc600Brush}" 
                               FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <Button Content="{Binding DashboardLabel}" 
                            Command="{Binding NavigateCommand}" CommandParameter="dashboard"
                            Style="{StaticResource SidebarButton}">
                        <Button.Triggers>
                            <!-- We use DataTriggers in the template instead -->
                        </Button.Triggers>
                    </Button>
                    <Button Content="{Binding SpecsLabel}" 
                            Command="{Binding NavigateCommand}" CommandParameter="specs"
                            Style="{StaticResource SidebarButton}" Margin="0,4,0,0"/>
                    <Button Content="{Binding AppsLabel}" 
                            Style="{StaticResource SidebarButton}" Margin="0,4,0,0" IsEnabled="False" Opacity="0.4"/>
                    <Button Content="{Binding NetworkLabel}" 
                            Style="{StaticResource SidebarButton}" Margin="0,4,0,0" IsEnabled="False" Opacity="0.4"/>
                    <Button Content="{Binding ProfilesLabel}" 
                            Style="{StaticResource SidebarButton}" Margin="0,4,0,0" IsEnabled="False" Opacity="0.4"/>
                </StackPanel>

                <!-- Settings / Language -->
                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <TextBlock Style="{StaticResource TextXs}" Text="{Binding LanguageLabel}" Foreground="{DynamicResource Zinc500Brush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="PT" Command="{Binding ChangeLanguageCommand}" CommandParameter="pt" Margin="0,0,8,0" Padding="12,4" Background="{DynamicResource Zinc800Brush}" Foreground="{DynamicResource Zinc300Brush}" BorderBrush="{DynamicResource Zinc700Brush}" BorderThickness="1" Cursor="Hand" />
                        <Button Content="EN" Command="{Binding ChangeLanguageCommand}" CommandParameter="en" Padding="12,4" Background="{DynamicResource Zinc800Brush}" Foreground="{DynamicResource Zinc300Brush}" BorderBrush="{DynamicResource Zinc700Brush}" BorderThickness="1" Cursor="Hand" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area (Routed via MVVM) -->
        <ContentControl Grid.Column="1" Margin="40" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
