{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: restore (Bitshift WPF)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "restore",
        "${workspaceFolder}/src/Bitshift/Bitshift.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: build (Bitshift WPF)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Bitshift/Bitshift.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: run (Bitshift WPF)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/Bitshift/Bitshift.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: clean (Bitshift WPF)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/src/Bitshift/Bitshift.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: publish (win-x64)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/src/Bitshift/Bitshift.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "false"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
